void OnProjectLoad(void) {
  //
  // emb_fwtk board-A (emitter) — debug via J-Link Remote Server on raspi5-03.
  // Client-side source substitution: the ELF was built inside the container
  // where the project lives at /workspace/RGBSensingModule; on this Mac the
  // checkout is ~/Documents/SCA/RGBSensingModule. Substitution is a fallback
  // (raw DWARF path tried first) and case-sensitive; all-lowercase prefix,
  // so a single entry suffices.
  //
  Project.SetDevice("STM32G431CB");
  Project.SetHostIF("IP", "127.0.0.1:19020");   // via SSH tunnel to raspi5-03
  Project.SetTargetIF("SWD");
  Project.SetTIFSpeed("1 MHz");
  Project.AddSvdFile("$(InstallDir)/Config/CPU/Cortex-M4F.svd");
  // FreeRTOS kernel awareness — fixes Warning 135; adds the Tasks window
  // (task list, state, stack usage) when halted. CM4 plugin matches the
  // Cortex-M4F core; if tasks don't appear, try FreeRTOSPlugin_ARM.js.
  Project.SetOSPlugin("$(InstallDir)/Plugins/OS/FreeRTOSPlugin_CM4.js");

  File.Open("Firmware-boardA.elf");

  // Destinations are $(ProjectDir)-relative so the same .jdebug works on any
  // machine that has (or mounts) the source tree: relative paths adapt to
  // wherever the project folder lives. See docs/debug-topologies.md.
  Project.AddPathSubstitute(
    "/workspace/RGBSensingModule",
    "$(ProjectDir)/../../SCA/RGBSensingModule"
  );
  // The ELF also carries refs from an older build layout whose comp_dir was
  // /workspace/Firmware (disjoint prefix, same files on disk).
  Project.AddPathSubstitute(
    "/workspace/Firmware",
    "$(ProjectDir)/../../SCA/RGBSensingModule/Firmware"
  );

  //
  // Board is running live firmware (boot-default LEDs OFF, FW v1.2).
  // Attach without reset so we don't disturb the sensor task.
  //
  Debug.SetConnectMode(CM_ATTACH);
}

void AfterTargetReset(void) {
  // Keep LEDs off after any reset from the debugger — the RESUME carousel
  // poisons ambient calibration if it lights up.
}
